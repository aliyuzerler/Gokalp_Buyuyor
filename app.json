{
  "expo": {
    "name": "Gökalp Büyüyor",
    "slug": "gokalp-buyuyor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gokalpbuyuyor",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F3EC",
    "ios": {
      "bundleIdentifier": "com.gokalp.buyuyor",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Gökalp'in anılarını arşive eklemek için fotoğraf seçmeniz gerekir.",
        "NSPhotoLibraryAddUsageDescription": "Arşivdeki fotoğrafları galerinize kaydetmeniz gerekir.",
        "NSCameraUsageDescription": "Anı kayıtlarına fotoğraf/video eklemek için kamera kullanılır."
      }
    },
    "android": {
      "package": "com.gokalp.buyuyor",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gökalp'in anılarını arşive eklemek için fotoğraf seçmeniz gerekir.",
          "cameraPermission": "Anı kayıtlarına fotoğraf/video eklemek için kamera kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A77C5C"
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": false
        }
      ],
      "react-native-zip-archive",
      "expo-sharing"
    ],
    "experiments": {}
  }
}
